#!/usr/bin/env sh
# Starter local pre-commit gate. Copy to .git/hooks/pre-commit (chmod +x), or wire it via husky /
# lefthook / pre-commit. Replace each <CMD> with the command from AGENTS.md → Key Commands.
#
# HONEST NOTE: a client-side hook is convenience, not enforcement — any agent can bypass it with
# `git commit --no-verify`, and a non-agent tool may not run it at all. The binding plane is
# required CI (scripts/templates/ci-verify.yml). This hook just catches problems a few seconds
# earlier for the people who keep it installed.
set -eu

echo "pre-commit: typecheck…"; <TYPECHECK_CMD>
echo "pre-commit: lint…";      <LINT_CMD>
echo "pre-commit: test…";      <TEST_CMD>

# Architecture boundaries (delete if no boundary linter is wired yet — MODULE:arch dropped).
echo "pre-commit: architecture boundaries…"; <ARCH_CHECK_CMD>

# Keep the tool-native agent mirrors in sync with AGENTS.md (fails if a mirror drifted).
if [ -f scripts/sync-agents.sh ]; then
  echo "pre-commit: agent mirrors…"; sh scripts/sync-agents.sh --check
fi

# Docs landing gate — no code change lands without its worklog line in the same commit.
if [ -f scripts/check-docs.sh ]; then
  echo "pre-commit: docs gate…"; sh scripts/check-docs.sh
fi

# Plan-home gate — a new plan doc may only be added inside docs/agents/ (roadmap row + area folder).
if [ -f scripts/check-plan-home.sh ]; then
  echo "pre-commit: plan home…"; sh scripts/check-plan-home.sh --staged
fi

# Spec gate — a structural change must carry a spec, with no unresolved ambiguity left in it.
# Doctrine: .agents/rules/spec.md. SPEC_OFF=1 is the stated escape hatch (say that you used it).
if [ -f scripts/check-spec.sh ]; then
  echo "pre-commit: spec…"; sh scripts/check-spec.sh --staged
fi

# Expert-review gate (local: checks staged change for trivial escape or review evidence).
if [ -f scripts/check-expert-review.sh ]; then
  echo "pre-commit: expert review…"; sh scripts/check-expert-review.sh
fi

echo "pre-commit: OK"
